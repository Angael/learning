---
import Callout from '../../../../../components/Callout.astro';
import Code from '../../../../../components/Code.astro';
import ReplyTask from '../../../../../components/ReplyTask.astro';
import SessionPage from '../../../../../components/SessionPage.astro';
import SessionSection from '../../../../../components/SessionSection.astro';
import { session } from './_session.ts';

const model = `_logger.LogInformation(
    "Order {OrderId} completed with status {StatusCode}",
    order.Id,
    StatusCodes.Status200OK);`;

const unsafeExample = `_logger.LogInformation(
    $"Created widget from {request} with key {request.ApiKey}");`;

const task = `public sealed record CreateWidgetRequest(string Name, string ApiKey);

var widget = await widgetService.CreateAsync(request.Name);

// Replace this unsafe log:
_logger.LogInformation(
    $"Created widget from {request} with key {request.ApiKey}");

return Results.Created($"/widgets/{widget.Id}", widget);`;
---

<SessionPage session={session}
  title="Session 11 · .NET: structured logging"
  heading="Log the outcome, not the secret"
  lede="A useful log has a clear event and named fields. It should help you find a request outcome without copying sensitive input into storage."
  backHref="/topics/dotnet/"
  backLabel=".NET sessions"
>
  <SessionSection title="Keep values as named data">
    <Code code={model} lang="csharp" />
    <p>The text has stable names such as <code>OrderId</code> and <code>StatusCode</code>. A log system can store and search those fields. <code>ILogger</code> keeps the endpoint independent of one logging provider.</p>
    <Callout>Use message templates with <code>{'{FieldName}'}</code>. Do not use string interpolation when you want structured fields.</Callout>
  </SessionSection>

  <SessionSection title="What not to record">
    <Code code={unsafeExample} lang="csharp" />
    <p>This copies a raw request and an API key into the log. Logs are often stored and shared. A secret in a log is still a leaked secret.</p>
  </SessionSection>

  <SessionSection title="Write one safe event">
    <Code code={task} lang="csharp" />
  </SessionSection>

  <ReplyTask id="learn:dotnet/011:q1" difficulty={3}>
    <ol>
      <li>Replace the unsafe call with one <code>LogInformation</code> call.</li>
      <li>Include named fields for <code>WidgetId</code> and <code>StatusCode</code>.</li>
      <li>In one short sentence, name the value that must stay out of the log.</li>
    </ol>
    <p>Reply with the log call and one sentence. Do not add a logging package or provider.</p>
  </ReplyTask>
</SessionPage>
