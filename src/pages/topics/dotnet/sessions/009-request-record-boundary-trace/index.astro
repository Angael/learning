---
import Callout from '../../../../../components/Callout.astro';
import Code from '../../../../../components/Code.astro';
import ReplyTask from '../../../../../components/ReplyTask.astro';
import SessionPage from '../../../../../components/SessionPage.astro';
import SessionSection from '../../../../../components/SessionSection.astro';

const recordCode = `public record TicketRequest(
    string EventCode,
    int Seats,
    string? Note);`;

const endpointCode = `app.MapPost("/tickets", (TicketRequest request) =>
{
    if (request.Seats is < 1 or > 6)
    {
        return Results.BadRequest(new
        {
            error = "Seats must be between 1 and 6."
        });
    }

    return Results.Ok();
});`;

const requestBody = `{
  "Note": "Aisle seat, please.",
  "Seats": 8,
  "EventCode": "JAZZ-42"
}`;

const replyText = `[learn:dotnet/009:q1]

Read the supplied code and request only. Do not write or run code.

TicketRequest.cs:
