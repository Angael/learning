{
    if (request.Seats is < 1 or > 6)
    {
        return Results.BadRequest(new
        {
            error = "Seats must be between 1 and 6."
        });
    }

    return Results.Ok();
});

Supplied JSON request body:
{
  "Note": "Aisle seat, please.",
  "Seats": 8,
  "EventCode": "JAZZ-42"
}

Trace only this request. Stop when it reaches a return. Do not analyse the other path. Exact JSON spacing does not matter.

