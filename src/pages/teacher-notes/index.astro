---
import PageShell from '../../components/PageShell.astro';
import { learningWeeks } from '../../data/learning/weeks.ts';

const weeklyNotes = [...learningWeeks]
  .sort((left, right) => right.id.localeCompare(left.id))
  .map((week) => ({ title: week.id, href: `/teacher-notes/weekly/${week.id}/` }));
---

<PageShell
  title="Teacher notes · Learning"
  heading="Teacher notes"
  summary="Public weekly curriculum synthesis and typed topic plans. Exact student evidence stays with each session."
>

  <section class="notes-section">
    <h2>Weekly notes</h2>
    <ul>
      {weeklyNotes.map((note) => <li><a href={note.href}>{note.title}</a></li>)}
    </ul>
  </section>

  <section class="notes-section">
    <h2>Topic plans</h2>
    <ul>
      <li><a href="/topics/csharp/plan/">C# plan</a></li>
      <li><a href="/topics/dotnet/plan/">.NET plan</a></li>
      <li><a href="/topics/german/plan/">German plan</a></li>
    </ul>
  </section>
</PageShell>

<style>
  .notes-section {
    padding: 20px 0;
    border-top: 1px solid var(--line);
  }

  .notes-section h2 {
    margin: 0 0 8px;
    font-size: 1.15rem;
  }

  .notes-section ul {
    margin: 10px 0 0;
    padding-left: 1.15rem;
  }

  .notes-section li + li {
    margin-top: 6px;
  }

  .notes-section a {
    color: var(--link);
    font-weight: 650;
  }
</style>
