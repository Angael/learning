---
import PageShell from './PageShell.astro';
import type { ILearningWeek } from '../data/learning/types.ts';

type Props = { note: ILearningWeek };
const { note } = Astro.props;
---

<PageShell title={`Week ${note.id}`} heading={`Week ${note.id}`} summary="Typed weekly learning synthesis." backHref="/teacher-notes/" backLabel="Teacher notes" narrow>
  <section><h2>Intent</h2><ul>{note.intent.map((item) => <li>{item}</li>)}</ul></section>
  <section><h2>Coverage</h2><ul>{note.coverage.map((item) => <li>{item}</li>)}</ul></section>
  <section><h2>Backlog</h2><ul>{note.backlog.map((item) => <li>{item}</li>)}</ul></section>
  <section><h2>Outlook</h2><ul>{note.outlook.map((item) => <li>{item}</li>)}</ul></section>
  <details class="archive"><summary>Full typed record</summary><pre>{JSON.stringify(note, null, 2)}</pre></details>
</PageShell>

<style>
  section { margin: 0 0 24px; }
  h2 { margin: 0 0 8px; }
  p, li { color: var(--muted); line-height: 1.6; }
  .archive summary { cursor: pointer; font-weight: 700; }
  pre { max-height: 36rem; overflow: auto; }
</style>
