---
import BaseLayout from './BaseLayout.astro';
import type { ILearningSession } from '../data/learning/types.ts';

type Props = {
  session: ILearningSession;
  title: string;
  heading: string;
  lede: string;
  backHref: string;
  backLabel: string;
};

const { session, title, heading, lede, backHref, backLabel } = Astro.props;
const taskEntries = Object.entries(session.replyTasks);
---

<BaseLayout title={title}>
  <main class="session-shell">
    <nav class="session-nav"><a href={backHref}>← {backLabel}</a></nav>

    <header class="session-header">
      <h1 class="session-title" set:html={heading} />
      <p class="session-lede">{lede}</p>
    </header>

    <aside class="session-record" aria-label="Session record">
      <p class="session-record__type">{session.type}</p>
      <h2>Why this session exists</h2>
      <p>{session.why}</p>
      <dl>
        <div><dt>Session ID</dt><dd><code>{session.id}</code></dd></div>
        <div><dt>Builds on</dt><dd>{session.buildsOn.length ? session.buildsOn.join(', ') : 'Historical session; no typed prerequisite was retained.'}</dd></div>
        <div><dt>Focus</dt><dd><ul>{session.focus.map((item) => <li>{item}</li>)}</ul></dd></div>
        <div><dt>Reply tasks</dt><dd>{taskEntries.length ? <ul>{taskEntries.map(([id, responses]) => <li><code>{id}</code> · {session.replyTaskState[id]} · {responses.length} learner response{responses.length === 1 ? '' : 's'}</li>)}</ul> : 'No reply task recorded.'}</dd></div>
      </dl>
      <details>
        <summary>Full typed session record</summary>
        <pre>{JSON.stringify(session, null, 2)}</pre>
      </details>
    </aside>

    <slot />
  </main>
</BaseLayout>

<style is:global>
  .session-shell { width: min(860px, calc(100% - 20px)); margin: 0 auto; padding: 28px 0 64px; }
  .session-nav { margin-bottom: 32px; }
  .session-nav a { color: var(--muted); }
  .session-nav a:hover { color: var(--accent); }
  .session-header { margin-bottom: 28px; }
  .session-title { max-width: 820px; margin: 0 0 12px; font-size: clamp(2.1rem, 8vw, 5.2rem); line-height: .92; letter-spacing: -.065em; }
  .session-lede { max-width: 700px; font-size: 1.08rem; line-height: 1.6; }
  .session-record { display: grid; gap: 10px; margin: 0 0 28px; padding: 18px; border: 1px solid var(--line); border-radius: 16px; background: var(--surface); }
  .session-record__type { width: fit-content; margin: 0; padding: 3px 8px; border-radius: 999px; background: var(--code); color: var(--code-text) !important; font-size: .8rem; font-weight: 800; text-transform: uppercase; letter-spacing: .05em; }
  .session-record h2 { margin: 0; font-size: 1.1rem; }
  .session-record p { margin: 0; }
  .session-record dl { display: grid; gap: 10px; margin: 0; }
  .session-record dl > div { display: grid; gap: 3px; }
  .session-record dt { color: var(--text); font-weight: 750; }
  .session-record dd { margin: 0; color: var(--muted); }
  .session-record ul { margin: 0; }
  .session-record details { margin-top: 4px; }
  .session-record summary { cursor: pointer; font-weight: 700; }
  .session-record pre { max-height: 28rem; }
  .session-shell h3 { margin: 22px 0 8px; font-size: 1rem; }
  .session-shell p, .session-shell li { color: var(--muted); line-height: 1.6; }
  .session-shell p { margin: 0 0 12px; }
  .session-shell ul, .session-shell ol { margin: 10px 0 0; padding-left: 1.25rem; }
  .session-shell strong { color: var(--text); }
  .session-shell pre { max-width: 100%; margin: 12px 0 0; padding: 16px; overflow-x: auto; border-radius: 16px; background: var(--code); color: var(--code-text); line-height: 1.55; }
  @media (min-width: 760px) { .session-shell { width: min(860px, calc(100% - 32px)); padding-top: 52px; } }
</style>
